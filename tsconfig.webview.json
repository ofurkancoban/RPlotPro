{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "outDir": "out-webview",
        "rootDir": "webview/src",
        "lib": ["es2020", "dom"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "types": ["node", "mocha"]
    },
    "include": ["webview/src/**/*.ts"],
    "comment": "main.ts is the esbuild bundle entry (ported JS, not strict-typed); it is built by build:webview, not type-checked here.",
    "exclude": ["webview/src/main.ts"]
}
